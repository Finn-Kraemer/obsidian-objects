{
  "name": "objects",
  "version": "2.4.1",
  "description": "A plugin for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src/**",
    "preversion": "npm run build && npm run lint",
    "version": "node version-bump.mjs && git add manifest.json versions.json release/manifest.json release/main.js release/styles.css",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "release:bug": "npm version patch && git push --follow-tags"
  },
  "keywords": [],
  "author": "Finn-Kraemer",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "esbuild": "0.25.0",
    "eslint": "^10.2.0",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.9.3"
  }
}
